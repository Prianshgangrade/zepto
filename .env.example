# Environment configuration template (copy or run scripts/bootstrap_secrets.py)
ZEPTO_ENV=development
ZEPTO_DATA_DIR=./data
ZEPTO_SECRETS_PATH=./.secrets/vault.json
STRICT_SECRETS=false

# Service ports
API_GATEWAY_PORT=8000
CATALOGUES_PORT=8001
CART_PORT=8002
ORDERS_PORT=8003
PAYMENTS_PORT=8004
NOTIFICATION_PORT=8005

# Service URLs (used by gateway & internal sync clients)
CATALOGUES_URL=http://127.0.0.1:8001
CART_URL=http://127.0.0.1:8002
ORDERS_URL=http://127.0.0.1:8003
PAYMENTS_URL=http://127.0.0.1:8004
NOTIFICATION_URL=http://127.0.0.1:8005

# Resilience defaults
HTTP_TIMEOUT_SECONDS=2.5
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT_SECONDS=12.0
